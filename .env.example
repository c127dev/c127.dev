# Copy to .env, chmod 600. Token from the "Edit Cloudflare Workers" template:
#   Account - Workers Scripts: Edit, Account Settings: Read
#   Zone    - Workers Routes: Edit (c127.dev)
CLOUDFLARE_API_TOKEN=

# Only when the token sees more than one account.
#CLOUDFLARE_ACCOUNT_ID=
